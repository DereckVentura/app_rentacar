# Copiar a .env y completar solo la contraseña generada para autorent_app.
# Este archivo es una plantilla: no contiene credenciales reales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=autorent
DB_USER=autorent_app
DB_PASSWORD=""

# Generar localmente con npm.cmd run auth:setup. No compartir esta clave.
JWT_SECRET=""

# Producción: completar con los datos del proveedor. Mantener TLS verificable.
DB_SSL=false
DB_SSL_CA_BASE64=""
DB_POOL_SIZE=5
# Orígenes web exactos separados por coma. Android no necesita CORS.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 0 directo; 1 detrás del proxy de Render. No exponer la API directamente en ese modo.
TRUST_PROXY_HOPS=0

# Opcional para subir nuevas fotos desde la administración.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Solo durante migraciones, con permisos DDL; nunca en el servicio API habitual.
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=
